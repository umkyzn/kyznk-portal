---
import '../styles/global.css';

/** The entire content of the site. Add a link by adding a line. */
const links = [
  { label: 'github', href: 'https://github.com/umkyzn' },
  { label: 'bruhsailer', href: 'https://umkyzn.github.io/BRUHsailer/' },
];

/**
 * Icon row. Each entry becomes one column, and the row stays centred however
 * many there are. `path` is the `d` of a single path on a 24x24 grid, drawn as
 * a stroke so it inherits the link colour.
 */
const icons = [
  {
    label: 'email',
    href: 'mailto:contact@kyznk.dev',
    path: 'M2.5 6h19v12h-19z M2.5 6 12 12.6 21.5 6',
  },
];

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const title = 'kyznk.dev';
const description = 'kyznk.dev';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <!-- Decorative: four slow-drifting radial gradients, a vignette holding
         contrast under the text, and grain to stop the gradients banding. -->
    <div class="mesh" aria-hidden="true">
      <span class="blob blob-1"></span>
      <span class="blob blob-2"></span>
      <span class="blob blob-3"></span>
      <span class="blob blob-4"></span>
    </div>
    <div class="vignette" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <main class="center">
      <ul class="links">
        {
          links.map((link) => (
            <li>
              <a href={link.href} rel="noopener noreferrer">
                <span class="link-label">{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <ul class="icons">
        {
          icons.map((icon) => (
            <li>
              <a
                href={icon.href}
                aria-label={icon.label}
                rel={icon.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={icon.path} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
