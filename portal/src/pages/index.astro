---
import '../styles/global.css';

/** The entire content of the site. Add a link by adding a line. */
const links = [
  { label: 'github', href: 'https://github.com/umkyzn' },
  { label: 'bruhsailer', href: 'https://umkyzn.github.io/BRUHsailer/' },
];

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const title = 'kyznk.dev';
const description = 'kyznk.dev';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <!-- Decorative: four slow-drifting radial gradients, a vignette holding
         contrast under the text, and grain to stop the gradients banding. -->
    <div class="mesh" aria-hidden="true">
      <span class="blob blob-1"></span>
      <span class="blob blob-2"></span>
      <span class="blob blob-3"></span>
      <span class="blob blob-4"></span>
    </div>
    <div class="vignette" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <main class="center">
      <ul class="links">
        {
          links.map((link) => (
            <li>
              <a href={link.href} rel="noopener noreferrer">
                <span class="link-label">{link.label}</span>
                <span class="link-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
